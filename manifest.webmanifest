{"name":"PrzerwaPro - Rejestrator Przerw","short_name":"PrzerwaPro","description":"Aplikacja PWA do rejestrowania przerw w pracy z limitem 30 min, alarmem dźwiękowym i kalendarzem.","start_url":"./","display":"standalone","background_color":"#0f172a","theme_color":"#0f172a","lang":"en","scope":"./","id":"./","orientation":"portrait","icons":[{"src":"./pwa-192x192.png","sizes":"192x192","type":"image/png","purpose":"any"},{"src":"./pwa-512x512.png","sizes":"512x512","type":"image/png","purpose":"any"},{"src":"/pwa-maskable-512x512.png","sizes":"512x512","type":"image/png","purpose":"maskable"}],"shortcuts":[{"name":"Widget Start & Stop","short_name":"Widget","description":"Jeden widget z dwoma przyciskami Start i Stop","url":"./?mode=widget","icons":[{"src":"./pwa-192x192.png","sizes":"192x192"}]},{"name":"Rozpocznij przerwę (Start)","short_name":"Start","description":"Szybkie rozpoczęcie przerwy","url":"./?action=start","icons":[{"src":"./pwa-192x192.png","sizes":"192x192"}]},{"name":"Zakończ przerwę (Stop)","short_name":"Stop","description":"Zakończenie aktywnej przerwy","url":"./?action=stop","icons":[{"src":"./pwa-192x192.png","sizes":"192x192"}]},{"name":"Miesięczny Kalendarz","short_name":"Kalendarz","description":"Zobacz historię przerw","url":"./?tab=calendar","icons":[{"src":"./pwa-192x192.png","sizes":"192x192"}]}]}
